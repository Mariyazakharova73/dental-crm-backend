generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  birthDate String @db.VarChar(10)
  email     String
  comment   String
}
